{
  "expo": {
    "name": "BasuraGo Staff",
    "slug": "basurago-staff",
    "scheme": "basurago-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.edliann.basurago.staff",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BasuraGo Staff to scan pickup QR codes",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b79be6a-9971-4eab-a4c4-aed140155c1c"
      }
    }
  }
}
