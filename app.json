{
  "expo": {
    "name": "BasuraGo Staff",
    "slug": "basurago-staff",
    "scheme": "basurago-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.edliann.basurago.staff",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "backgroundImage": "./assets/icon.png",
        "backgroundColor": "#004D2B"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BasuraGo Staff to scan pickup QR codes",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d98bcc1f-8c29-4e8a-811b-8e4961d85313"
      }
    },
    "owner": "darzzz"
  }
}
